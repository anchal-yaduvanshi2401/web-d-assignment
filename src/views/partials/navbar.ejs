<header class="navbar">
  <div class="nav-container">
    <a href="/" class="nav-brand">
      🎓 PlacementHub
      <span class="badge">Campus Portal</span>
    </a>

    <nav>
      <ul class="nav-links">
        <li><a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Home</a></li>

        <% if (currentUser && currentUser.role === 'admin') { %>
          <li><a href="/admin/dashboard" class="<%= currentPath === '/admin/dashboard' ? 'active' : '' %>">Dashboard</a></li>
          <li><a href="/admin/drives" class="<%= currentPath.startsWith('/admin/drives') ? 'active' : '' %>">Drives</a></li>
          <li><a href="/admin/applications" class="<%= currentPath.startsWith('/admin/applications') ? 'active' : '' %>">Applications</a></li>
          <li><a href="/admin/students" class="<%= currentPath.startsWith('/admin/students') ? 'active' : '' %>">Students</a></li>
        <% } else if (currentUser && currentUser.role === 'student') { %>
          <li><a href="/student/dashboard" class="<%= currentPath === '/student/dashboard' ? 'active' : '' %>">Dashboard</a></li>
          <li><a href="/student/drives" class="<%= currentPath.startsWith('/student/drives') ? 'active' : '' %>">Browse Drives</a></li>
          <li><a href="/student/applications" class="<%= currentPath.startsWith('/student/applications') ? 'active' : '' %>">My Applications</a></li>
          <li><a href="/student/profile" class="<%= currentPath.startsWith('/student/profile') ? 'active' : '' %>">Profile</a></li>
        <% } %>
      </ul>
    </nav>

    <div class="nav-actions">
      <% if (currentUser) { %>
        <div class="nav-user-pill">
          <span><%= currentUser.name %></span>
          <span class="user-role-badge role-<%= currentUser.role %>"><%= currentUser.role %></span>
        </div>
        <a href="/auth/logout" class="btn btn-secondary btn-sm">Logout</a>
      <% } else { %>
        <a href="/auth/login" class="btn btn-secondary btn-sm">Login</a>
        <a href="/auth/register" class="btn btn-primary btn-sm">Student Register</a>
      <% } %>
    </div>
  </div>
</header>
