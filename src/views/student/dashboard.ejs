<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="main-wrapper">
  <%- include('../partials/alerts') %>

  <div class="page-header">
    <div>
      <h1 class="page-title">Welcome, <%= student.name %> 👋</h1>
      <p class="page-subtitle">
        Roll No: <strong><%= student.rollNumber || 'Not set' %></strong> &bull; 
        Branch: <strong><%= student.branch %></strong> &bull; 
        CGPA: <strong><%= student.cgpa.toFixed(2) %></strong>
      </p>
    </div>
    <div style="display: flex; gap: 0.5rem;">
      <a href="/student/profile" class="btn btn-secondary btn-sm">Edit Profile</a>
      <a href="/student/drives" class="btn btn-primary btn-sm">Browse Drives &rarr;</a>
    </div>
  </div>

  <!-- Stats Grid -->
  <div class="stats-grid">
    <div class="stat-card">
      <span class="stat-label">Active Drives</span>
      <div class="stat-value"><%= stats.totalOpenDrives %></div>
      <span class="stat-helper">Open campus drives</span>
    </div>

    <div class="stat-card">
      <span class="stat-label">Eligible Drives</span>
      <div class="stat-value" style="color: var(--success);"><%= stats.eligibleDrivesCount %></div>
      <span class="stat-helper">Matched by CGPA & branch</span>
    </div>

    <div class="stat-card">
      <span class="stat-label">Applications</span>
      <div class="stat-value" style="color: var(--accent);"><%= stats.totalApplied %></div>
      <span class="stat-helper">Submitted by you</span>
    </div>

    <div class="stat-card">
      <span class="stat-label">Offers / Selections</span>
      <div class="stat-value" style="color: #15803d;"><%= stats.selectedCount %></div>
      <span class="stat-helper"><%= stats.shortlistedCount %> shortlisted</span>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: 1fr; gap: 2rem;">
    <!-- Recent Applications Tracker -->
    <div class="card">
      <div class="card-header">
        <h2>My Recent Applications</h2>
        <a href="/student/applications" class="btn btn-secondary btn-sm">View All Applications</a>
      </div>
      <div class="card-body" style="padding: 0;">
        <% if (recentApplications && recentApplications.length > 0) { %>
          <div class="table-responsive">
            <table class="table">
              <thead>
                <tr>
                  <th>Company</th>
                  <th>Role</th>
                  <th>Applied On</th>
                  <th>Status</th>
                  <th>Placement Remarks</th>
                </tr>
              </thead>
              <tbody>
                <% recentApplications.forEach(app => { %>
                  <tr>
                    <td><strong><%= app.drive ? app.drive.companyName : 'Drive Removed' %></strong></td>
                    <td><%= app.drive ? app.drive.roleTitle : '-' %></td>
                    <td><%= new Date(app.appliedAt).toLocaleDateString() %></td>
                    <td>
                      <span class="badge badge-<%= app.status.toLowerCase() %>">
                        <%= app.status %>
                      </span>
                    </td>
                    <td><%= app.adminNotes || 'Under initial review' %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div style="padding: 2.5rem 1.5rem; text-align: center; color: var(--text-muted);">
            <p style="font-size: 1.1rem; margin-bottom: 0.5rem;">No applications submitted yet.</p>
            <p style="font-size: 0.9rem; margin-bottom: 1.25rem;">Browse active drives and apply to positions matching your profile!</p>
            <a href="/student/drives" class="btn btn-primary btn-sm">Find Eligible Drives</a>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Recommended / Recent Drives -->
    <div class="card">
      <div class="card-header">
        <h2>Active Recruitment & Internship Drives</h2>
        <a href="/student/drives" class="btn btn-secondary btn-sm">Browse All Drives</a>
      </div>
      <div class="card-body">
        <% if (recentDrives && recentDrives.length > 0) { %>
          <div class="drives-grid" style="margin-bottom: 0;">
            <% recentDrives.forEach(drive => { %>
              <div class="drive-card">
                <div class="drive-card-header">
                  <span class="badge badge-<%= drive.jobType === 'Internship' ? 'internship' : 'placement' %>">
                    <%= drive.jobType %>
                  </span>
                  <h3 class="company-title" style="margin-top: 0.4rem;"><%= drive.companyName %></h3>
                  <p class="role-subtitle"><%= drive.roleTitle %></p>
                </div>
                <div class="drive-card-body">
                  <div class="drive-info-row">
                    <span>Package:</span>
                    <strong><%= drive.packageOrStipend %></strong>
                  </div>
                  <div class="drive-info-row">
                    <span>Cutoff CGPA:</span>
                    <strong><%= drive.minCGPA.toFixed(1) %></strong>
                  </div>
                  <div class="drive-info-row">
                    <span>Branches:</span>
                    <span><%= drive.eligibleBranches.join(', ') %></span>
                  </div>
                  <div style="margin-top: 0.5rem;">
                    <% if (drive.hasApplied) { %>
                      <span class="badge badge-applied">✓ Already Applied</span>
                    <% } else if (drive.eligibility.canApply) { %>
                      <span class="badge badge-eligible">✓ Eligible to Apply</span>
                    <% } else { %>
                      <span class="badge badge-ineligible" title="<%= drive.eligibility.reasons.join('; ') %>">
                        ✕ Ineligible
                      </span>
                    <% } %>
                  </div>
                </div>
                <div class="drive-card-footer">
                  <a href="/student/drives/<%= drive._id %>" class="btn btn-secondary btn-sm btn-block">
                    View Details
                  </a>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <p style="text-align: center; color: var(--text-muted); padding: 1.5rem 0;">No active drives posted right now.</p>
        <% } %>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
