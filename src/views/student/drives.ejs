<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="main-wrapper">
  <%- include('../partials/alerts') %>

  <div class="page-header">
    <div>
      <h1 class="page-title">Placement & Internship Drives</h1>
      <p class="page-subtitle">
        Your CGPA: <strong><%= student.cgpa.toFixed(2) %></strong> &bull; Branch: <strong><%= student.branch %></strong>
      </p>
    </div>
  </div>

  <!-- Search and Filter Bar -->
  <div class="filter-bar">
    <form action="/student/drives" method="GET" class="filter-form">
      <div class="form-group" style="flex: 2;">
        <input
          type="text"
          name="search"
          class="form-control"
          placeholder="Search by company name or role..."
          value="<%= currentFilter.search %>"
        />
      </div>

      <div class="form-group">
        <select name="type" class="form-control">
          <option value="">All Opportunity Types</option>
          <option value="Full-time Placement" <%= currentFilter.type === 'Full-time Placement' ? 'selected' : '' %>>Full-time Placement</option>
          <option value="Internship" <%= currentFilter.type === 'Internship' ? 'selected' : '' %>>Internship</option>
        </select>
      </div>

      <div class="form-group">
        <select name="eligibilityFilter" class="form-control">
          <option value="">All Drives</option>
          <option value="eligible" <%= currentFilter.eligibilityFilter === 'eligible' ? 'selected' : '' %>>Only Eligible Drives</option>
          <option value="ineligible" <%= currentFilter.eligibilityFilter === 'ineligible' ? 'selected' : '' %>>Ineligible Drives</option>
        </select>
      </div>

      <button type="submit" class="btn btn-primary btn-sm" style="height: 42px;">Filter</button>
      <a href="/student/drives" class="btn btn-secondary btn-sm" style="height: 42px;">Reset</a>
    </form>
  </div>

  <!-- Drives Grid -->
  <% if (drives && drives.length > 0) { %>
    <div class="drives-grid">
      <% drives.forEach(drive => { %>
        <div class="drive-card">
          <div class="drive-card-header">
            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
              <span class="badge badge-<%= drive.jobType === 'Internship' ? 'internship' : 'placement' %>">
                <%= drive.jobType %>
              </span>
              <% if (drive.hasApplied) { %>
                <span class="badge badge-<%= (drive.applicationStatus || 'applied').toLowerCase() %>">
                  Status: <%= drive.applicationStatus %>
                </span>
              <% } else if (drive.eligibility.canApply) { %>
                <span class="badge badge-eligible">Eligible</span>
              <% } else { %>
                <span class="badge badge-ineligible">Ineligible</span>
              <% } %>
            </div>
            <h3 class="company-title" style="margin-top: 0.6rem;"><%= drive.companyName %></h3>
            <p class="role-subtitle"><%= drive.roleTitle %></p>
          </div>

          <div class="drive-card-body">
            <div class="drive-info-row">
              <span>Package / Stipend:</span>
              <strong><%= drive.packageOrStipend %></strong>
            </div>
            <div class="drive-info-row">
              <span>Min CGPA Required:</span>
              <strong><%= drive.minCGPA.toFixed(1) %></strong>
            </div>
            <div class="drive-info-row">
              <span>Eligible Branches:</span>
              <span><%= drive.eligibleBranches.join(', ') %></span>
            </div>
            <div class="drive-info-row">
              <span>Application Deadline:</span>
              <strong><%= new Date(drive.deadline).toLocaleDateString() %></strong>
            </div>

            <!-- Ineligibility Notice if applicable -->
            <% if (!drive.hasApplied && !drive.eligibility.canApply) { %>
              <div style="margin-top: 0.5rem; padding: 0.5rem; background: #fff1f2; border-radius: var(--radius-sm); border: 1px solid #fecdd3; font-size: 0.78rem; color: #be123c;">
                <strong>Eligibility Note:</strong>
                <%= drive.eligibility.reasons.join(' ') %>
              </div>
            <% } %>
          </div>

          <div class="drive-card-footer">
            <a href="/student/drives/<%= drive._id %>" class="btn btn-secondary btn-sm">
              Full Details
            </a>

            <% if (drive.hasApplied) { %>
              <a href="/student/applications" class="btn btn-primary btn-sm" style="background-color: #0284c7;">
                Track Status &rarr;
              </a>
            <% } else if (drive.eligibility.canApply) { %>
              <form action="/student/drives/<%= drive._id %>/apply" method="POST" style="margin: 0;">
                <button type="submit" class="btn btn-success btn-sm">
                  Apply Now &check;
                </button>
              </form>
            <% } else { %>
              <button class="btn btn-secondary btn-sm" disabled>
                Not Eligible
              </button>
            <% } %>
          </div>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <div class="card">
      <div class="card-body" style="text-align: center; padding: 3rem 1.5rem; color: var(--text-muted);">
        <p style="font-size: 1.2rem; margin-bottom: 0.5rem;">No drives matched your filter criteria.</p>
        <p style="font-size: 0.9rem; margin-bottom: 1rem;">Try clearing your filters or search terms.</p>
        <a href="/student/drives" class="btn btn-primary btn-sm">Show All Drives</a>
      </div>
    </div>
  <% } %>
</main>

<%- include('../partials/footer') %>
