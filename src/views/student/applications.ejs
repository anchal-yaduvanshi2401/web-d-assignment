<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="main-wrapper">
  <%- include('../partials/alerts') %>

  <div class="page-header">
    <div>
      <h1 class="page-title">My Applications & Status Tracking</h1>
      <p class="page-subtitle">Track the real-time review progress of your drive applications</p>
    </div>
    <a href="/student/drives" class="btn btn-primary btn-sm">+ Browse More Drives</a>
  </div>

  <div class="card">
    <div class="card-header">
      <h2>Submitted Applications (<%= applications.length %>)</h2>
    </div>

    <div class="card-body" style="padding: 0;">
      <% if (applications && applications.length > 0) { %>
        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th>Company & Role</th>
                <th>Type</th>
                <th>Package / Stipend</th>
                <th>Applied Date</th>
                <th>Current Status</th>
                <th>Placement Officer Remarks</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% applications.forEach(app => { %>
                <tr>
                  <td>
                    <% if (app.drive) { %>
                      <strong><%= app.drive.companyName %></strong>
                      <div style="font-size: 0.8rem; color: var(--text-muted);"><%= app.drive.roleTitle %></div>
                    <% } else { %>
                      <em>Drive Concluded / Removed</em>
                    <% } %>
                  </td>
                  <td>
                    <% if (app.drive) { %>
                      <span class="badge badge-<%= app.drive.jobType === 'Internship' ? 'internship' : 'placement' %>">
                        <%= app.drive.jobType %>
                      </span>
                    <% } %>
                  </td>
                  <td><%= app.drive ? app.drive.packageOrStipend : '-' %></td>
                  <td><%= new Date(app.appliedAt).toLocaleDateString() %></td>
                  <td>
                    <span class="badge badge-<%= app.status.toLowerCase() %>" style="font-size: 0.8rem;">
                      <%= app.status %>
                    </span>
                  </td>
                  <td>
                    <% if (app.adminNotes) { %>
                      <div style="font-size: 0.85rem; color: #1e293b; background: #f8fafc; padding: 0.4rem 0.6rem; border-radius: 4px; border-left: 3px solid var(--accent);">
                        <%= app.adminNotes %>
                      </div>
                    <% } else { %>
                      <span style="color: var(--text-light); font-size: 0.8rem;">No remarks yet</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (app.drive) { %>
                      <a href="/student/drives/<%= app.drive._id %>" class="btn btn-secondary btn-sm">
                        View Drive
                      </a>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div style="padding: 3rem 1.5rem; text-align: center; color: var(--text-muted);">
          <p style="font-size: 1.15rem; margin-bottom: 0.5rem;">You haven't applied to any drives yet.</p>
          <p style="font-size: 0.9rem; margin-bottom: 1.25rem;">Explore recruitment drives that match your CGPA and branch.</p>
          <a href="/student/drives" class="btn btn-primary">Browse Available Drives</a>
        </div>
      <% } %>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
